# Server Port
PORT=3000

# Persistent storage directories (leave blank for default ./data and ./uploads)
DATA_DIR=
UPLOAD_DIR=

# Admin Authentication
ADMIN_USER=admin
# Generate hash with: node server/hash.js "your-strong-password"
ADMIN_PASSWORD_HASH=

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (e.g., https://syednehajafferyy.github.io,http://localhost:5173), or * for all
CORS_ORIGIN=*

# Cookie Settings
# Set COOKIE_SECURE=1 when deploying on HTTPS
COOKIE_SECURE=0
COOKIE_SAMESITE=Lax
