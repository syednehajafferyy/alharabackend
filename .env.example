# PostgreSQL Database Connection (Neon, Supabase, RDS, etc.)
DATABASE_URL=postgresql://neondb_owner:npg_w5qAMLWkZbV8@ep-calm-hat-b45uu5p7-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# Admin Authentication
ADMIN_USER=admin
# Generate hash with: node server/hash.js "your-strong-password"
ADMIN_PASSWORD_HASH=

# Cross-Origin Resource Sharing (CORS)
# Set to * to allow all origins, or comma-separated domains (e.g., https://your-frontend.vercel.app,http://localhost:3000)
CORS_ORIGIN=*

# Cookie Settings
# Set COOKIE_SECURE=1 on Vercel or production HTTPS
COOKIE_SECURE=1
COOKIE_SAMESITE=None

# Optional: Local Server Port (default 3000)
PORT=3000
